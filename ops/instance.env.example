# Lorefold client channel instance — copy and edit, one file per client.
#
#   cp ops/instance.env.example ops/dave.env && $EDITOR ops/dave.env
#
# ops/*.env is gitignored. NEVER commit a real password.
#
# ---------------------------------------------------------------------------
# What this file is for
# ---------------------------------------------------------------------------
# A second stack, isolated from your own workspace because it is a different
# server process with a different graph. That is the only isolation Lorefold
# has: there are no accounts, no roles and no per-page permissions, so a person
# you want to keep out of your other clients' work has to be kept out at the
# process boundary. See doc/client-channel-model.md.
#
# Keep it thin. This is a channel — the page you and the client pass back and
# forth — not the client's own knowledge base. The durable record belongs in
# YOUR workspace, where backlinks and the lorefold/decision index actually
# work, and the MCP bridge is what carries decisions across.
#
# ---------------------------------------------------------------------------
# Running it
# ---------------------------------------------------------------------------
# Every command needs --env-file, and it must come BEFORE -f:
#
#   docker compose --env-file ops/dave.env -f ops/compose.m0.yml up -d
#   docker compose --env-file ops/dave.env -f ops/compose.m0.yml ps
#   docker compose --env-file ops/dave.env -f ops/compose.m0.yml down
#
# TRAP: --env-file REPLACES ops/.env rather than merging with it, which is why
# this template is complete rather than a fragment. Do not trim it down to the
# lines that differ.
#
# TRAP: forget --env-file and compose resolves the project name to the default
# instance. `docker compose -f ops/compose.m0.yml down` while you meant this
# stack will stop YOUR workspace instead. There is no confirmation prompt.


# ---------------------------------------------------------------------------
# LOREFOLD_INSTANCE — names the compose project: lorefold-<instance>
# ---------------------------------------------------------------------------
# Also selects the backup archive directory and the off-host subdirectory, so
# two instances can never overwrite each other's backups. Use a short, stable,
# lowercase name. Changing it later orphans this stack's containers and
# archives under the old name.
LOREFOLD_INSTANCE=dave


# ---------------------------------------------------------------------------
# LOREFOLD_DATA_DIR — where this instance's graph lives
# ---------------------------------------------------------------------------
# Resolved RELATIVE TO ops/, because that is how compose resolves relative bind
# mounts. An absolute path works too. Must be unique per instance.
#
# NEVER nest one instance's data directory inside another's. The cold backup
# tars the whole directory, so a nested instance lands inside another client's
# archive. Keep them siblings.
LOREFOLD_DATA_DIR=../athens-data-dave


# ---------------------------------------------------------------------------
# LOREFOLD_PORT — host port for this instance
# ---------------------------------------------------------------------------
# The container always listens on 3010; this is the host side only. Must be
# unique per instance. 3010 is the default workspace, so start at 3011.
LOREFOLD_PORT=3011


# ---------------------------------------------------------------------------
# ATHENS_PASSWORD — this instance's shared password
# ---------------------------------------------------------------------------
# MUST be different from every other instance's. This is the password you give
# the client, and it is the only thing standing between them and full read and
# write access to this graph. Reusing your own workspace password here would
# hand them your entire practice.
#
# Generate: openssl rand -base64 24
# Write it bare, no surrounding quotes — the compose file adds the EDN quotes.
ATHENS_PASSWORD=CHANGE-ME


# ---------------------------------------------------------------------------
# ATHENS_BIND_ADDR — which host interface publishes LOREFOLD_PORT
# ---------------------------------------------------------------------------
# Per LF-8 (ops/RUNBOOK.md section 15) this should be the host's tailnet
# address, never 0.0.0.0 on a public network. M0 has no TLS: the password
# crosses the wire in HTTP Basic on every API call, so the tailnet is what
# supplies encryption in transit and device-level access control.
#
# A client reaches their channel by being shared onto that single node in
# Tailscale — not by being added to your tailnet at large.
ATHENS_BIND_ADDR=127.0.0.1


# ---------------------------------------------------------------------------
# TZ — container timezone
# ---------------------------------------------------------------------------
# Resolves "@today" and daily-note titles. Set it to the timezone the work
# happens in; a mismatch silently files notes on the wrong day.
TZ=America/New_York


# ---------------------------------------------------------------------------
# CONFIG_EDN — full server-config override (escape hatch; normally leave unset)
# ---------------------------------------------------------------------------
# compose.m0.yml builds a complete CONFIG_EDN from ATHENS_PASSWORD. Setting it
# here replaces the whole value, so you must repeat :password and
# :feature-flags {:api true} yourself or the REST API — and therefore the MCP
# bridge — turns off.
#
# HARD RULES:
#   - NEVER add :nrepl. Unauthenticated remote REPL = arbitrary code execution.
#   - NEVER set :in-memory? true. It silently persists nothing.
#
# CONFIG_EDN={:password "CHANGE-ME" :feature-flags {:api true}}


# ---------------------------------------------------------------------------
# LOREFOLD_OFFHOST_DEST — off-host backup destination
# ---------------------------------------------------------------------------
# ops/backup/offhost.sh appends /<LOREFOLD_INSTANCE> to whatever you set here,
# so several instances can share one destination without colliding. Set it to
# the same root as your own workspace and each lands in its own subdirectory.
#
# A directory:      LOREFOLD_OFFHOST_DEST=/Volumes/Backup/lorefold
# An rclone remote: LOREFOLD_OFFHOST_DEST=rclone:b2-lorefold:lorefold/backups
#
# The export is this client's entire graph in plain EDN. If the destination is
# storage you do not control, put an `rclone crypt` remote in front of it.
# LOREFOLD_OFFHOST_DEST=

# OFFHOST_KEEP — copies to keep at a directory destination (default 14).
# OFFHOST_KEEP=14
