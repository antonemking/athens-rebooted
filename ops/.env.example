# Lorefold M0 environment — copy to ops/.env and edit.
#
#   cp ops/.env.example ops/.env
#
# ops/.env is gitignored. NEVER commit a real password. This example file
# carries placeholders only.
#
# Compose loads ops/.env automatically when you run
# `docker compose -f ops/compose.m0.yml ...` from the repository root, because
# the project directory is the directory containing the compose file.
#
# After editing, always confirm what actually reaches the container:
#   docker compose -f ops/compose.m0.yml config | grep -E 'CONFIG_EDN|TZ'
#
# This file configures YOUR workspace — the one holding every client. A client
# channel instance gets its own file from ops/instance.env.example; see
# ops/RUNBOOK.md section 18.


# ---------------------------------------------------------------------------
# LOREFOLD_INSTANCE / LOREFOLD_DATA_DIR / LOREFOLD_PORT — which stack is this
# ---------------------------------------------------------------------------
# All three default to what the single-instance M0 stack has always used, so
# leaving them unset keeps an existing deployment byte-for-byte identical. They
# exist so a second stack can run beside this one on the same host, which is
# the ONLY isolation mechanism there is — one graph per server process, no
# accounts, no per-page permissions.
#
#   LOREFOLD_INSTANCE   compose project name suffix   (default: m0)
#   LOREFOLD_DATA_DIR   graph data, relative to ops/  (default: ../athens-data)
#   LOREFOLD_PORT       host port                     (default: 3010)
#
# Leave them commented out here. Set them in a per-instance file instead.
# LOREFOLD_INSTANCE=m0
# LOREFOLD_DATA_DIR=../athens-data
# LOREFOLD_PORT=3010


# ---------------------------------------------------------------------------
# ATHENS_PASSWORD — the single shared graph password
# ---------------------------------------------------------------------------
# This one password guards both the websocket (browser clients) and HTTP Basic
# auth on /api/*. There are no accounts, no roles and no per-page permissions:
# whoever has this password has full read and write access to the entire graph.
# Generate something long and random, e.g. `openssl rand -base64 24`.
#
# It is interpolated into CONFIG_EDN by ops/compose.m0.yml. Write it bare here,
# with NO surrounding quotes — the compose file adds the EDN double quotes.
ATHENS_PASSWORD=CHANGE-ME


# ---------------------------------------------------------------------------
# TZ — container timezone
# ---------------------------------------------------------------------------
# The server resolves "@today" and daily-note titles ("August 09, 2026") from
# the container clock. Leave this unset and the container runs UTC, so the
# daily page rolls over at the wrong local hour and notes land on the wrong
# day. Set it to the timezone you actually work in (IANA name).
TZ=America/New_York


# ---------------------------------------------------------------------------
# ATHENS_BIND_ADDR — which host interface publishes port 3010
# ---------------------------------------------------------------------------
# Default is 0.0.0.0 (reachable from the LAN), which is what the two-browser
# presence check needs. Set to 127.0.0.1 for a strictly local stack.
# Fluree's 8090 is never published on any interface — see ops/compose.m0.yml.
ATHENS_BIND_ADDR=0.0.0.0


# ---------------------------------------------------------------------------
# CONFIG_EDN — full server-config override (escape hatch; normally leave unset)
# ---------------------------------------------------------------------------
# ops/compose.m0.yml already builds a complete CONFIG_EDN from ATHENS_PASSWORD:
#
#   CONFIG_EDN: '{:password "CHANGE-ME" :feature-flags {:api true}}'
#
# Set CONFIG_EDN here ONLY if you need to change more than the password. Doing
# so replaces the whole value, so you must repeat :password and
# :feature-flags {:api true} yourself or the REST API turns off.
#
# THE QUOTING TRAP. The server parses this as EDN, where string values must be
# in double quotes, and YAML strips double quotes from a double-quoted or
# unquoted scalar. In the compose file the value is therefore wrapped in SINGLE
# quotes so the inner double quotes survive. In this .env file there is no YAML
# layer — write the value bare, with no outer quotes of any kind, and keep the
# inner double quotes around the password:
#
#   CONFIG_EDN={:password "CHANGE-ME" :feature-flags {:api true}}
#
# CONFIG_EDN is deep-merged into src/clj/config.default.edn, so list only the
# keys that differ from the defaults.
#
# HARD RULES:
#   - NEVER add :nrepl. It starts an unauthenticated remote REPL, i.e.
#     arbitrary code execution on a reachable host.
#   - NEVER set :in-memory? true. It silently persists nothing; every event is
#     lost on restart, with no error and no warning.
#
# Feature flags worth knowing: :api is the server-side REST flag and is the
# only one that belongs here. The tasks/properties/queries/comments/
# notifications flags are CLIENT settings, toggled per-browser in Settings —
# see ops/RUNBOOK.md.
#
# CONFIG_EDN={:password "CHANGE-ME" :feature-flags {:api true}}


# ---------------------------------------------------------------------------
# LOREFOLD_OFFHOST_DEST — where the nightly backup is copied off this machine
# ---------------------------------------------------------------------------
# ops/backup/backup.sh writes under athens-data/ and ops/backup/archives/, both
# of which are on the same disk as the graph. A copy on that disk does not
# survive that disk. ops/backup/offhost.sh reads this variable and copies the
# newest hot export and cold archive somewhere else.
#
# Either a directory — an external disk, a mounted share, a synced folder:
#   LOREFOLD_OFFHOST_DEST=/Volumes/Backup/lorefold
# or an rclone remote, for object storage (configure it with `rclone config`):
#   LOREFOLD_OFFHOST_DEST=rclone:b2-lorefold:lorefold/backups
#
# offhost.sh appends /<LOREFOLD_INSTANCE> to this path, so every instance on
# the host can point at the same root and still land in its own subdirectory.
# Without that, two instances' exports share the name backup-<date>.edn and
# each night's push would overwrite the other's — one client's ledger silently
# replaced by another's. If you already have off-host copies from before this
# split, move them into the m0/ subdirectory; see ops/RUNBOOK.md section 18.
#
# The export is the entire decision ledger in plain EDN. If the destination is
# storage you do not control, put an `rclone crypt` remote in front of it.
#
# A directory destination that does not exist is treated as an error, not as a
# directory to create: that case is almost always an external disk that is not
# plugged in, and silently "backing up" to the internal disk is the exact
# failure this guards against.
# LOREFOLD_OFFHOST_DEST=

# OFFHOST_KEEP — copies to keep at a directory destination (default 14). For an
# rclone remote, use the bucket's own lifecycle rules instead.
# OFFHOST_KEEP=14


# ---------------------------------------------------------------------------
# LOREFOLD_DOMAIN — reserved, not used in M0
# ---------------------------------------------------------------------------
# M0 serves plain HTTP on :3010 with no TLS and no reverse proxy. A domain
# only becomes meaningful once Caddy fronts the stack in M1 (LF-20/LF-22).
# Recorded here so the variable name is settled before it is needed.
# LOREFOLD_DOMAIN=lorefold.example.com
