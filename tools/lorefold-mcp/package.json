{
  "name": "lorefold-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP bridge to a self-hosted Lorefold knowledge graph, over the REST API the server already exposes.",
  "license": "EPL-1.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lorefold-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
